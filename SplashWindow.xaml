<Window x:Class="SOACS.Arsenal.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SOACS Arsenal" Height="520" Width="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#080A08" Foreground="#F0F6E8" ShowInTaskbar="False" Topmost="True">
