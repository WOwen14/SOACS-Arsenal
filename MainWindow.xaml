<Window x:Class="SOACS.Arsenal.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SOACS Arsenal" Icon="Assets/AppIcon.ico" Height="900" Width="1440" MinWidth="1100" MinHeight="700" WindowState="Maximized" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <Border Grid.Row="0" CornerRadius="10" BorderBrush="#B9FF00" BorderThickness="1" Background="#111711" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Image Source="Assets/Logo.png" Width="102" Height="102" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SOACS ARSENAL" FontSize="34" Foreground="#B9FF00" FontFamily="Consolas" FontWeight="Bold"/><TextBlock Text="ENTERPRISE PATCH MANAGEMENT" FontSize="17"/><TextBlock Text="Offline application intelligence, SHA-256 qualification, dependency planning, and guarded execution" Margin="0,8,0,0" Foreground="#D6FF6A"/></StackPanel>
   <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="SYSTEM CLOCK" Foreground="#B9FF00" HorizontalAlignment="Right"/><TextBlock Text="{Binding ClockText}" FontSize="28" Foreground="#55FF79" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/><TextBlock Text="v1.5.3 Alpha" Foreground="#D6FF6A" HorizontalAlignment="Right" Margin="0,4,0,0"/><Button Content="ABOUT" Click="About_Click" Width="110" HorizontalAlignment="Right"/></StackPanel>
  </Grid></Border>
  <UniformGrid Grid.Row="1" Columns="6" Margin="0,8">
   <Border BorderBrush="#B9FF00" BorderThickness="1" CornerRadius="8" Margin="3"><StackPanel VerticalAlignment="Center"><TextBlock Text="FOUND" HorizontalAlignment="Center" Foreground="#B9FF00"/><TextBlock Text="{Binding FoundCount}" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
   <Border BorderBrush="#55FF79" BorderThickness="1" CornerRadius="8" Margin="3"><StackPanel VerticalAlignment="Center"><TextBlock Text="COMPLETED" HorizontalAlignment="Center" Foreground="#55FF79"/><TextBlock Text="{Binding CompletedCount}" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#55FF79"/></StackPanel></Border>
   <Border BorderBrush="#FF4D5E" BorderThickness="1" CornerRadius="8" Margin="3"><StackPanel VerticalAlignment="Center"><TextBlock Text="FAILED" HorizontalAlignment="Center" Foreground="#FF4D5E"/><TextBlock Text="{Binding FailedCount}" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#FF4D5E"/></StackPanel></Border>
   <Border BorderBrush="#FFAA33" BorderThickness="1" CornerRadius="8" Margin="3"><StackPanel VerticalAlignment="Center"><TextBlock Text="MANUAL" HorizontalAlignment="Center" Foreground="#FFAA33"/><TextBlock Text="{Binding ManualCount}" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#FFAA33"/></StackPanel></Border>
   <Border BorderBrush="#FFD84D" BorderThickness="1" CornerRadius="8" Margin="3"><StackPanel VerticalAlignment="Center"><TextBlock Text="REBOOT" HorizontalAlignment="Center" Foreground="#FFD84D"/><TextBlock Text="{Binding RebootCount}" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#FFD84D"/></StackPanel></Border>
   <Border BorderBrush="#B9FF00" BorderThickness="1" CornerRadius="8" Margin="3"><StackPanel VerticalAlignment="Center"><TextBlock Text="PROGRESS" HorizontalAlignment="Center" Foreground="#B9FF00"/><TextBlock Text="{Binding OverallProgressText}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="2" Margin="0,4,0,8">
   <TabItem Header="DASHBOARD"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="#B9FF00" BorderThickness="1" CornerRadius="8" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MONTHLY PATCH REPOSITORY" Foreground="#B9FF00" FontWeight="Bold"/><TextBox Text="{Binding RepositoryPath}" IsReadOnly="True" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="SELECT FOLDER" Click="Browse_Click"/><Button Content="SCAN &amp; PLAN" Click="Scan_Click"/><Button Content="QUALIFY MACHINE" Click="Qualify_Click"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border BorderBrush="#364336" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="CURRENT ACTIVITY" Foreground="#B9FF00" FontWeight="Bold"/><TextBlock Text="{Binding CurrentActivity}" FontSize="21" Margin="0,8" TextWrapping="Wrap"/><ProgressBar Value="{Binding OverallProgress}" Height="22" Maximum="100"/><TextBlock Text="{Binding SummaryText}" Foreground="#D6FF6A" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" BorderBrush="#364336" BorderThickness="1" CornerRadius="8" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="MACHINE QUALIFICATION" Foreground="#B9FF00" FontWeight="Bold"/><TextBlock Text="{Binding QualificationStatus}" FontSize="20" Margin="0,8,0,4"/><TextBlock Text="{Binding QualificationDetails}" TextWrapping="Wrap" Foreground="#D6FF6A"/></StackPanel></Border></Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="INSTALL PLANNED UPDATES" Click="InstallAll_Click" Padding="18,10"/><Button Content="STOP AFTER CURRENT" Click="Stop_Click"/><Button Content="EXPORT REPORT" Click="Export_Click"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="INSTALL PLAN"><DataGrid ItemsSource="{Binding Patches}" SelectedItem="{Binding SelectedPatch}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="45"/><DataGridTemplateColumn Header="STATUS" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="170"/><DataGridTextColumn Header="PACKAGE" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="RULE" Binding="{Binding RuleName}" Width="180"/><DataGridTemplateColumn Header="HASH" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HashStatus}" Foreground="{Binding HashBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="300"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="FIRMWARE"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#FFAA33" BorderThickness="1" CornerRadius="8" Padding="10"><TextBlock Text="Firmware packages require successful machine qualification, vendor matching, and explicit operator approval. BitLocker may need to be suspended manually before execution." TextWrapping="Wrap" Foreground="#FFD84D"/></Border><DataGrid Grid.Row="1" ItemsSource="{Binding FirmwarePatches}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTemplateColumn Header="STATUS" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PACKAGE" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="VALIDATION" Binding="{Binding Result}" Width="500"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="MANUAL REVIEW"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="TEACH ARSENAL FOR SELECTED EXE" Click="TeachSelected_Click" Padding="16,9"/><Button Content="OPEN APPLICATION RULES" Click="OpenRules_Click"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding ManualPatches}" SelectedItem="{Binding SelectedPatch}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="150"/><DataGridTextColumn Header="PACKAGE" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="180"/><DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="200"/><DataGridTemplateColumn Header="HASH" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HashStatus}" Foreground="{Binding HashBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="REASON" Binding="{Binding Result}" Width="360"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="PACKAGE VALIDATION"><DataGrid ItemsSource="{Binding Patches}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="PACKAGE" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="190"/><DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="220"/><DataGridTextColumn Header="VERSION" Binding="{Binding FileVersion}" Width="130"/><DataGridTextColumn Header="RULE" Binding="{Binding RuleName}" Width="180"/><DataGridTemplateColumn Header="SHA-256" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HashStatus}" Foreground="{Binding HashBrush}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="EXPECTED" Binding="{Binding ExpectedHash}" Width="260"/><DataGridTextColumn Header="CALCULATED" Binding="{Binding CalculatedHash}" Width="260"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="DEPLOYMENT PACKAGE"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="#B9FF00" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="OFFLINE DEPLOYMENT PACKAGE BUILDER" FontSize="22" FontWeight="Bold" Foreground="#B9FF00"/><TextBlock Text="Creates a standalone ZIP with a PowerShell deployment runner, custom application rules, the complete monthly repository, ordered install plan, PatchManifest.xml, SHA256SUMS.txt, launcher, and deployment instructions. Arsenal is not required on the target system." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#D6FF6A"/></StackPanel></Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12"><Button Content="BUILD DEPLOYMENT PACKAGE" Click="BuildDeployment_Click" Padding="18,10"/><Button Content="OPEN LAST PACKAGE" Click="OpenDeployment_Click"/><TextBlock Text="{Binding DeploymentStatus}" Margin="18,8,0,0" TextWrapping="Wrap" Foreground="#F0F6E8"/></StackPanel>
    <Border Grid.Row="2" BorderBrush="#364336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DEPLOYMENT BUILD PROGRESS" Foreground="#B9FF00" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding DeploymentProgressText}" Foreground="#B9FF00" FontSize="20" FontWeight="Bold"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding DeploymentProgress}" Maximum="100" Height="24" Margin="0,8,0,6"/><TextBlock Grid.Row="2" Text="{Binding DeploymentPhase}" Foreground="#FFD84D" FontSize="16" FontWeight="Bold"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeploymentStats}" Foreground="#D6FF6A" HorizontalAlignment="Right"/><TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding DeploymentCurrentFile}" Foreground="#F0F6E8" TextWrapping="Wrap" Margin="0,5,0,0"/></Grid></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
     <Border BorderBrush="#364336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="PACKAGE CONTENTS" Foreground="#B9FF00" FontWeight="Bold"/><TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#F0F6E8" Text="• Standalone Invoke-ArsenalDeployment.ps1 runner&#x0a;• Deploy.cmd administrator launcher&#x0a;• Current Rules/ApplicationRules.xml, including Teach Arsenal rules&#x0a;• Complete repository with dependencies, licenses, sidecar hashes, and manifests&#x0a;• PatchManifest.xml with the current ordered install plan&#x0a;• SHA256SUMS.txt for every deployment file&#x0a;• Logs and CSV results generated on the target system&#x0a;• Final ZIP copy for transfer to disconnected systems"/><TextBlock Text="The destination must be outside the source repository. Build after scanning so the deployment manifest contains the current install plan." Foreground="#FFD84D" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Grid.Column="1" BorderBrush="#364336" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LIVE BUILD LOG" Foreground="#B9FF00" FontWeight="Bold"/><ListBox Grid.Row="1" ItemsSource="{Binding DeploymentBuildLog}" Margin="0,8,0,0" FontFamily="Consolas" Foreground="#D6FF6A" Background="#080A08"/></Grid></Border>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="LIVE LOG"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding EventLog}" Background="#080A08" Foreground="#D6FF6A" FontFamily="Consolas"/><Button Grid.Row="1" Content="CLEAR LOG" Click="ClearLog_Click" HorizontalAlignment="Right"/></Grid></TabItem>
   <TabItem Header="ABOUT"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="Assets/Logo.png" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="25"><TextBlock Text="SOACS ARSENAL" FontSize="34" Foreground="#B9FF00" FontWeight="Bold"/><TextBlock Text="Enterprise Patch Management" FontSize="20" Margin="0,5,0,18"/><TextBlock Text="Version 1.5.3 Alpha adds a visible deployment build dashboard, live package-content log, current-file tracking, file and byte progress, automatic ZIP creation, ZIP verification, and deployment IDs while retaining application intelligence, SHA-256 qualification, dependency planning, all-user Store provisioning, and guarded firmware handling." TextWrapping="Wrap" FontSize="15"/><TextBlock Text="Firmware execution remains operator-approved by design." Foreground="#FFD84D" Margin="0,18,0,0"/></StackPanel></Grid></TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#111711" BorderBrush="#364336" BorderThickness="1" CornerRadius="6" Padding="8"><Grid><TextBlock Text="{Binding StatusBarText}" Foreground="#D6FF6A"/><TextBlock Text="SOACS ARSENAL • ADMINISTRATOR MODE" Foreground="#B9FF00" HorizontalAlignment="Right"/></Grid></Border>
 </Grid>
</Window>
